# Rendered at container start by the nginx image's envsubst entrypoint. It only
# substitutes variables set in the environment (BACKEND_FASTCGI, REVERB_UPSTREAM,
# FRONTEND_UPSTREAM), so nginx vars like $http_upgrade are left alone.

# php-fpm over the backend's TCP ingress, with persistent connections. Since the
# platform moved replicas on 2026-09-18/19, replies get lost when php-fpm closes the
# connection after answering: php-fpm logs a 200, nginx logs "recv() failed (104:
# Connection reset by peer) while reading response header" and returns 502.
# With fastcgi_keep_conn php-fpm keeps the connection open and nginx closes it, the
# same as the Postgres and Redis clients on this ingress, which work fine.
# keepalive_timeout is well under the ingress idle timeout (~6 min).
upstream kdai_backend {
    server ${BACKEND_FASTCGI};
    keepalive 8;
    keepalive_timeout 60s;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 2048M;

    # Laravel API via php-fpm
    location /api/ {
        fastcgi_pass kdai_backend;
        fastcgi_keep_conn on;
        fastcgi_index index.php;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /app/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param REQUEST_URI $uri?$args;
        # TLS ends at the Container Apps ingress
        fastcgi_param HTTPS on;
        # 2GB emulation uploads take a while to reach MinIO.
        fastcgi_read_timeout 600s;
        fastcgi_connect_timeout 75s;
        fastcgi_send_timeout 600s;
        # Stream the body to php-fpm. Buffering it here would fill nginx's ~1GB
        # /tmp with a 2GB upload; the backend has ~4GB for php-fpm's temp file.
        fastcgi_request_buffering off;
    }

    # Reverb websockets, via the Reverb app's internal https ingress.
    # Host is left as the upstream FQDN ($proxy_host); envoy routes on it.
    location /app/ {
        proxy_pass ${REVERB_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
        proxy_read_timeout 86400;
        proxy_buffering off;
    }

    # Health check
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Frontend SPA, via the frontend app's internal https ingress.
    location / {
        proxy_pass ${FRONTEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
    }
}
