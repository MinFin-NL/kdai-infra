# Substituted at container start by the nginx image's envsubst entrypoint.
# Only ${BACKEND_FASTCGI}, ${REVERB_UPSTREAM} and ${FRONTEND_UPSTREAM} are env
# vars; $-variables like $http_upgrade are nginx runtime vars and are left alone
# (the entrypoint only substitutes variables that exist in the environment).

# php-fpm over the backend's Container Apps TCP ingress, with persistent connections.
# Since the platform's 2026-09-18/19 replica moves, a reply is lost whenever php-fpm
# closes the connection after answering (its default without keep-conn): php-fpm logs
# 200, and nginx gets "recv() failed (104: Connection reset by peer) while reading response
# header" -> 502 on every /api/ call. Rolling nginx/php back to the known-good versions
# did not help, so it's the ingress. With fastcgi_keep_conn, php-fpm leaves the connection
# open and nginx does the closing, like the Postgres/Redis clients on the same ingress,
# which are unaffected. keepalive_timeout stays well below the ingress idle cut-off (~6 min).
upstream kdai_backend {
    server ${BACKEND_FASTCGI};
    keepalive 8;
    keepalive_timeout 60s;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 2048M;

    # API routes - Laravel via PHP-FPM (fastcgi over the backend's TCP ingress)
    location /api/ {
        fastcgi_pass kdai_backend;
        fastcgi_keep_conn on;
        fastcgi_index index.php;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /app/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param REQUEST_URI $uri?$args;
        # TLS is terminated by Container Apps ingress; tell Laravel it is https.
        fastcgi_param HTTPS on;
        # Large emulation uploads (up to 2GB) can take a while to buffer to nginx
        # and stream on to MinIO, so give php-fpm generous read/send windows.
        fastcgi_read_timeout 600s;
        fastcgi_connect_timeout 75s;
        fastcgi_send_timeout 600s;
        # Stream the request body straight to php-fpm instead of first buffering the
        # whole thing to a temp file on nginx's small ephemeral disk (this app runs at
        # 0.25 vCPU, ~1GB /tmp - a 2GB body would fill it and the upload would die on
        # nginx before ever reaching the backend). php-fpm writes its own upload temp
        # on the backend (1 vCPU, ~4GB), which fits 2GB.
        fastcgi_request_buffering off;
    }

    # WebSocket (Reverb) — proxied to the Reverb app's internal https ingress.
    # No Host override: nginx sets Host to the upstream FQDN ($proxy_host),
    # which Container Apps envoy needs for routing.
    location /app/ {
        proxy_pass ${REVERB_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
        proxy_read_timeout 86400;
        proxy_buffering off;
    }

    # Health check
    location /health {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }

    # Frontend SPA — proxied to the frontend app's internal https ingress.
    location / {
        proxy_pass ${FRONTEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_ssl_server_name on;
    }
}
